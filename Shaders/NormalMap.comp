#version 430 core

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(binding = 0) uniform sampler2DArray u_InputTexture;

layout(rgba8, binding = 0) writeonly uniform image2DArray u_OutputImage;

uniform float u_Strength = 5.0;

void main()
{
    ivec3 pixelCoords = ivec3(gl_GlobalInvocationID.xyz);
    ivec3 size = imageSize(u_OutputImage);

    if (pixelCoords.x >= size.x || pixelCoords.y >= size.y || pixelCoords.z >= size.z)
        return;

    vec2 texelSize = 1.0 / vec2(size.xy);
    vec2 uv = (vec2(pixelCoords.xy) + 0.5) * texelSize;
    float layer = float(pixelCoords.z);

    float h00 = texture(u_InputTexture, vec3(uv + vec2(-texelSize.x, -texelSize.y), layer)).r;
    float h10 = texture(u_InputTexture, vec3(uv + vec2(0.0,          -texelSize.y), layer)).r;
    float h20 = texture(u_InputTexture, vec3(uv + vec2( texelSize.x, -texelSize.y), layer)).r;

    float h01 = texture(u_InputTexture, vec3(uv + vec2(-texelSize.x,  0.0), layer)).r;
    float h21 = texture(u_InputTexture, vec3(uv + vec2( texelSize.x,  0.0), layer)).r;

    float h02 = texture(u_InputTexture, vec3(uv + vec2(-texelSize.x,  texelSize.y), layer)).r;
    float h12 = texture(u_InputTexture, vec3(uv + vec2(0.0,           texelSize.y), layer)).r;
    float h22 = texture(u_InputTexture, vec3(uv + vec2( texelSize.x,  texelSize.y), layer)).r;

    float dX = (h20 + 2.0 * h21 + h22) - (h00 + 2.0 * h01 + h02);
    float dY = (h02 + 2.0 * h12 + h22) - (h00 + 2.0 * h10 + h20);

    vec3 normal = normalize(vec3(-dX * u_Strength, -dY * u_Strength, 1.0));

    vec3 packedNormal = normal * 0.5 + 0.5;

    imageStore(u_OutputImage, pixelCoords, vec4(packedNormal, 1.0));
}